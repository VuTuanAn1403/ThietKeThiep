# ============================================================
# NHÀ CÓ TIỆC — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# ============================================================
# 1. PUBLIC ENVIRONMENT VARIABLES (Client & Server)
# ============================================================

# Supabase API Endpoint & Anon Public Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Website Base URL (Used for Canonical URLs, OpenGraph & Sitemaps)
# In production on Vercel, set to: https://your-domain.vercel.app or https://nhacotiec.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile / CAPTCHA Site Key (Optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxx

# Sentry Public DSN (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0000000

# Google Analytics 4 Measurement ID (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================
# 2. SERVER-ONLY SECRETS (Never expose to client or commit to git)
# ============================================================

# Supabase Service Role Key (Admin privileges for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-client

# Cloudflare Turnstile Secret Key (Optional)
TURNSTILE_SECRET_KEY=0x4AAAAAAyyyyyyyyyyyyyy

# Sentry Server DSN (Optional)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0000000

# Admin Bootstrap Credentials (Optional for seeding/scripting)
ADMIN_EMAIL=admin@nhacotiec.vn
ADMIN_PASSWORD=your-secure-admin-password

# Payment QR & Banking Information (Optional customization)
PAYMENT_BANK_NAME=DEMO BANK
PAYMENT_ACCOUNT_NUMBER=0000000000
PAYMENT_ACCOUNT_NAME=DEMO ACCOUNT
PAYMENT_QR_IMAGE=https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=DEMO_PAYMENT_ORDER
